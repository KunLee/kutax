# Copy to infra/.env (ignored). Replace each blank value with a different random secret.
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
DEVELOPMENT_SEED_PASSWORD=

# Optional Groq receipt reading. Leave AI_ENABLED=false to keep manual entry only.
# Review https://console.groq.com/docs/your-data and turn on Zero Data Retention in Groq's Data Controls first.
AI_ENABLED=false
AI_PROVIDER=Groq
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_REGION=Groq inference fleet (US and other regions); any retained data stored in Google Cloud, United States
AI_RETENTION_NOTICE=Groq does not keep inference inputs or outputs by default. Without Zero Data Retention it may log them for up to 30 days for reliability or abuse checks. Zero Data Retention is enabled for this workspace.
